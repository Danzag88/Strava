# Copy to .env and fill in. .env is gitignored.
# Client id lives in config/strava.toml. Do not put tokens in git.

STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_GRANTED_SCOPE=

# Set to true only for a one-off reseed after you approve Strava again.
RESEED_TOKEN=false

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=STRAVA_LOADER
SNOWFLAKE_ROLE=STRAVA_BACKUP
SNOWFLAKE_WAREHOUSE=STRAVA_WH
SNOWFLAKE_DATABASE=STRAVA
# Base64 of the PKCS8 PEM private key, one line, no spaces.
SNOWFLAKE_PRIVATE_KEY_B64=
